#!/bin/zsh

set -u
umask 077

readonly APP_ROOT="/Users/Shared/Lexistories"
readonly PYTHON_BIN="$APP_ROOT/.venv/bin/python3"
readonly STREAMLIT_APP="$APP_ROOT/app.py"
readonly USER_ID="$(/usr/bin/id -u)"
readonly PORT="$((18000 + USER_ID % 1000))"
readonly APP_URL="http://127.0.0.1:$PORT"
readonly STATE_DIR="$HOME/Library/Application Support/Lexistories"
readonly PID_FILE="$STATE_DIR/server.pid"
readonly LOG_FILE="$STATE_DIR/server.log"

show_error() {
    /usr/bin/osascript \
        -e 'on run argv' \
        -e 'display alert "Τα Μαθήματά μου" message (item 1 of argv) as critical' \
        -e 'end run' \
        "$1" >/dev/null
}

server_is_ready() {
    /usr/bin/curl --silent --fail --max-time 1 \
        "$APP_URL/_stcore/health" 2>/dev/null | /usr/bin/grep -q '^ok'
}

if [[ ! -x "$PYTHON_BIN" || ! -r "$STREAMLIT_APP" ]]; then
    show_error "Η κοινόχρηστη εγκατάσταση δεν βρέθηκε. Εκτέλεσε ξανά το install_for_all_users.sh."
    exit 1
fi

/bin/mkdir -p "$STATE_DIR"

if [[ -r "$PID_FILE" ]]; then
    existing_pid="$(<"$PID_FILE")"
    if [[ "$existing_pid" == <-> ]] && /bin/kill -0 "$existing_pid" 2>/dev/null && server_is_ready; then
        /usr/bin/open "$APP_URL"
        exit 0
    fi
fi

if server_is_ready; then
    /usr/bin/open "$APP_URL"
    exit 0
fi

export PYTHONDONTWRITEBYTECODE=1
export STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

cd "$APP_ROOT" || exit 1
/usr/bin/nohup "$PYTHON_BIN" -m streamlit run "$STREAMLIT_APP" \
    --server.address 127.0.0.1 \
    --server.port "$PORT" \
    --server.headless true \
    --server.fileWatcherType none \
    --browser.gatherUsageStats false \
    >"$LOG_FILE" 2>&1 &
server_pid=$!
print -r -- "$server_pid" >"$PID_FILE"

for attempt in {1..100}; do
    if server_is_ready; then
        /usr/bin/open "$APP_URL"
        exit 0
    fi
    if ! /bin/kill -0 "$server_pid" 2>/dev/null; then
        break
    fi
    /bin/sleep 0.1
done

show_error "Η εφαρμογή δεν ξεκίνησε. Το αρχείο καταγραφής είναι: $LOG_FILE"
exit 1
